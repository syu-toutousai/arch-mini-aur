pkgname=lib32-pam
pkgver=1.7.2
pkgrel=2
pkgdesc='Pluggable Authentication Modules'
arch=(x86_64)
url=http://linux-pam.org
license=(GPL2)
depends=(
  lib32-audit
  lib32-libnsl
  lib32-libtirpc
  lib32-libxcrypt
  lib32-systemd
  pam
)
makedepends=(
  meson
)
source=("linux-pam-$pkgver.tar.gz::https://codeload.github.com/linux-pam/linux-pam/tar.gz/refs/tags/v$pkgver")
sha256sums=('d7ce5cb6e07ee8603d8af41a672bcb515b9d27079ee309fb3f729a8020166694')
options=(!emptydirs)

build() {
  export CC='gcc -m32'
  export CXX='g++ -m32'
  export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'

  arch-meson linux-pam-$pkgver \
    --libdir=lib32 \
    -Dlogind=enabled \
    -Ddocs=disabled \
    -Deconf=disabled \
    -Dselinux=disabled \
    -Delogind=disabled \
    -Dpam_userdb=disabled \
    -Dpwaccess=disabled \
    build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
#  make DESTDIR="${pkgdir}" SCONFIGDIR=/etc/security -C linux-pam install
  rm -rf "${pkgdir}"/{etc,usr/{bin,include,lib,share}}
}

